# Node
node_modules/
# The development server and the production build get a directory each, so
# neither can leave chunks the other cannot read. See frontend/next.config.mjs.
.next/
.next-dev/
.next-prod/
out/
npm-debug.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Environment - never commit real values, only .env.example
.env
.env.*
!.env.example
!.env.*.example

# Server credentials, SSH keys, certificates - NEVER commit
server_cred/
.server_cred/
credentials/
secrets/
*.pem
*.key
*.ppk
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.crt
known_hosts
ssh.txt
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artefacts
frontend/.vercel
backend/.pytest_cache/

.vercel

# The pre-reset repository, kept as a safety net. Never publish it.
.git-old-backup/

# Browser-test scratch output
.playwright-mcp/
