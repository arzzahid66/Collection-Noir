# Node
node_modules/
# The development server and the production build get a directory each, so
# neither can leave chunks the other cannot read. See frontend/next.config.mjs.
.next/
.next-dev/
.next-prod/
out/
npm-debug.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Environment
.env
.env.local
.env.*.local

# Server credentials. The SSH private key for the API host lives here. It was
# untracked but not ignored, which is one `git add -A` away from being
# published, so the directory is named explicitly rather than relying on
# nobody staging it.
server_cred/
*.pem
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artefacts
frontend/.vercel
backend/.pytest_cache/

.vercel

# The pre-reset repository, kept as a safety net. Never publish it.
.git-old-backup/

# Browser-test scratch output
.playwright-mcp/
